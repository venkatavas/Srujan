# The site's public address, used for absolute URLs: the share image, the canonical link,
# robots.txt, the sitemap and the structured data. On Vercel the production domain is used
# when this is not set. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com

# Set to 1 to make the build fail while any draft or launch-required content is unresolved (for a
# release built outside Vercel; Vercel production deployments are always checked).
# CONTENT_GATE=1
